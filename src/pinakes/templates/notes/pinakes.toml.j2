[kb]
name     = "{{ name }}"
id       = "{{ kb_id }}"          # permanent — never edit or regenerate (docs/DESIGN.md §2.2)
template = "{{ template }}"
created  = "{{ created }}"

[sources]
roots   = ["docs/"]
include = ["**/*.md", "**/*.txt"]
exclude = ["**/drafts/**"]

[embedding]
provider = "{{ embedding_provider }}"
model    = "{{ embedding_model }}"
dim      = {{ embedding_dim }}
# revision = "…"   # pin the HF commit sha once you are settled; `pnk doctor` reports the current one

[chunking]
strategy   = "structural"
max_tokens = 510                  # <= the model's window minus special tokens
overlap    = 64

[retrieval]
candidates_per_source = 50
fusion                = "rrf"
fusion_top_k          = 20
final_k               = 8
rerank                = "local"
vector_tier           = "auto"

# [retrieval.confidence]
# Thresholds are fitted against *your* golden set, not shipped with the template: numbers fitted on
# someone else's corpus are not a calibration. Until then `pnk search` reports `confidence: unknown`,
# which is the honest answer. See eval/questions.yaml to start one.
# fitted_for = "{{ rerank_model }}@<revision>"
# low_below  = 0.31
# high_above = 0.62

[rerank]
provider = "{{ rerank_provider }}"
model    = "{{ rerank_model }}"

[budget]
confirm_above_eur = 0.01          # no shipped code path spends money; validated so a KB written
per_operation_eur = 0.05          # today stays valid when a paid path arrives (docs/STATUS.md)
monthly_eur       = 5.00
timezone          = "UTC"
on_exceed         = "abort"
