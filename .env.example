# Copy to `.env` and fill in. `.env` is gitignored; this file is not, and must never hold a key.
#
# **Nothing loads this automatically.** pinakes does not read `.env`, on purpose: a tool that can
# spend money should not pick up credentials from a file nobody pointed it at. Pass it explicitly:
#
#     uv run --env-file .env pnk sync --extract=claude-vision
#
# or export it into the shell yourself:
#
#     set -a && source .env && set +a
#
# Only the paid extractor needs this. Every other command — init, sync, search, doctor, budget,
# serve — runs without a key and cannot spend.
ANTHROPIC_API_KEY=
